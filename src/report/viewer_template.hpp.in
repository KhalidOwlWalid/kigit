//
// Stored as bytes rather than a string literal: MSVC rejects string literals
// longer than about 64 KB, and the viewer is bigger than that.
#pragma once

#include <string_view>

namespace kigit {

inline constexpr unsigned char kViewerBytes[] = {
@KIGIT_VIEWER_BYTES@
};

// The viewer page, with a /*KIGIT_DATA*/null marker where the data goes.
inline std::string_view viewer_template() {
    return {reinterpret_cast<const char*>(kViewerBytes), sizeof kViewerBytes};
}

} // namespace kigit
