# Keep test fixtures byte-for-byte identical on every OS (no CRLF conversion).
tests/fixtures/** -text
# Shell scripts must keep LF line endings to run.
*.sh text eol=lf
# The example project too: its commit hashes depend on the exact bytes
# (pinned in tests/cpp/test_cli.cpp), so no CRLF on Windows checkouts.
examples/** -text
